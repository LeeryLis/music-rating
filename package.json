{
    "name": "music-rating",
    "version": "1.0.2",
    "description": "Music rating widget plugin for Obsidian",
    "main": "main.js",
    "scripts": {
        "sync-version": "node scripts/sync-version.mjs",
        "dev": "npm run sync-version && node esbuild.config.mjs",
        "build": "npm run sync-version && tsc --noEmit && node esbuild.config.mjs production"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.20.0",
        "obsidian": "latest",
        "tslib": "^2.6.0",
        "typescript": "^5.3.0"
    }
}
